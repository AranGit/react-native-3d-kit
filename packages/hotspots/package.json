{
  "name": "@arangit/react-native-3d-hotspots",
  "version": "0.1.0",
  "description": "World-space React Native hotspots for @arangit/react-native-model-viewer.",
  "main": "./lib/module/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/index.d.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "types": "./lib/typescript/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bob build",
    "clean": "rimraf lib coverage",
    "lint": "eslint src __tests__ --ext .ts,.tsx --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --config jest.config.js --runInBand"
  },
  "keywords": [
    "react-native",
    "3d",
    "hotspots",
    "annotations",
    "filament"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AranGit/react-native-3d-kit.git",
    "directory": "packages/hotspots"
  },
  "homepage": "https://github.com/AranGit/react-native-3d-kit#readme",
  "bugs": {
    "url": "https://github.com/AranGit/react-native-3d-kit/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@arangit/react-native-model-viewer": "^0.1.0",
    "react": ">=19.2.0 <20",
    "react-native": ">=0.83.10 <0.84"
  },
  "devDependencies": {
    "@arangit/react-native-model-viewer": "workspace:*",
    "react": "19.2.0",
    "react-native": "0.83.10"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
