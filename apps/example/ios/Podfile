# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# The prebuilt ViroKit 2.58.1 framework has an iOS 17.6 deployment target.
# This raises only the private example app; the public packages keep their own
# compatibility ranges.
platform :ios, '17.6'
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'ReactNative3DKitExample' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # ViroReact supplies the ARKit renderer used by the AR placement example.
  # AR sessions require a physical iOS device; the simulator is unsupported.
  pod 'ViroReact', :path => '../../../node_modules/@reactvision/react-viro/ios'
  pod 'ViroKit', :path => '../../../node_modules/@reactvision/react-viro/ios/dist/ViroRenderer/'

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
