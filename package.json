{
  "name": "react-native-3d-kit",
  "version": "0.0.0",
  "private": true,
  "description": "A pnpm monorepo for composable React Native 3D packages built on react-native-filament.",
  "license": "MIT",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.3.0 <25"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "clean": "pnpm -r clean",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "deps:check": "madge --circular --extensions ts,tsx packages",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore",
    "validate": "pnpm lint && pnpm typecheck && pnpm test && pnpm deps:check && pnpm build",
    "pack:check": "node ./scripts/validate-packages.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm format:check && pnpm validate && pnpm pack:check && changeset publish",
    "example:start": "pnpm --filter react-native-3d-kit-example start",
    "example:ios": "pnpm --filter react-native-3d-kit-example ios",
    "example:android": "pnpm --filter react-native-3d-kit-example android",
    "native:android:build": "pnpm --filter react-native-3d-kit-example native:android:build",
    "native:ios:pods": "pnpm --filter react-native-3d-kit-example native:ios:pods",
    "native:ios:build": "pnpm --filter react-native-3d-kit-example native:ios:build"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@changesets/cli": "3.0.1",
    "@react-native/babel-preset": "0.83.10",
    "@react-native/eslint-config": "0.83.10",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "26.2.0",
    "@types/react": "19.2.0",
    "babel-jest": "29.7.0",
    "eslint": "8.57.1",
    "jest": "29.7.0",
    "madge": "8.0.0",
    "prettier": "3.9.6",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-builder-bob": "0.43.0",
    "react-test-renderer": "19.2.0",
    "rimraf": "6.1.3",
    "typescript": "5.8.3"
  }
}
